---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon';
import LeadQuiz from '../components/LeadQuiz';
import ReviewsTabs from '../components/ReviewsTabs';
import StickyCta from '../components/StickyCta';
import { contacts, socials } from '../data/site';

const baseUrl = import.meta.env.BASE_URL;

const pickers = [
  { label: 'Квартира', icon: 'building', goal: 'Купити', type: 'Квартира' },
  { label: 'Будинок', icon: 'house', goal: 'Купити', type: 'Будинок' },
  { label: 'Дуплекс', icon: 'duplex', goal: 'Купити', type: 'Дуплекс' },
  { label: 'Таунхаус', icon: 'townhouse', goal: 'Купити', type: 'Таунхаус' },
  { label: 'Комерція', icon: 'store', goal: 'Купити', type: 'Комерційна' },
  { label: 'Ділянка', icon: 'land', goal: 'Купити', type: 'Ділянка' },
  { label: 'Продати свою нерухомість', icon: 'tag', goal: 'Продати', wide: true },
];

const ticker = [
  '0% комісії для покупця',
  'Напряму від власників і забудовників',
  'єОселя та єВідновлення',
  'Розтермінування від забудовників',
  'Онлайн та офлайн перегляди',
  'Юрист і нотаріус до ключів',
  'Platinum-партнер Rieltor.ua',
];

const perks = [
  { icon: 'percent', title: 'Без комісії для покупця', text: 'Працюємо напряму з власниками й забудовниками. Ви платите ринкову ціну об’єкта — без відсотків зверху.' },
  { icon: 'shield', title: 'Тільки перевірені об’єкти', text: 'Лише актуальні пропозиції з реальними цінами. Юридичну чистоту об’єкта перевіряє юрист.' },
  { icon: 'doc', title: 'Державні програми', text: 'Підбираємо житло під єОселю, сертифікати єВідновлення та державні постанови — і ведемо угоду до кінця.' },
  { icon: 'calendar', title: 'Розтермінування', text: 'Знаємо, у кого з забудовників зараз діють розтермінування та спеціальні умови, і підкажемо, де вигідніше.' },
  { icon: 'video', title: 'Перегляд звідусіль', text: 'Покажемо об’єкт наживо або по відеозв’язку — зручно, якщо ви в іншому місті чи за кордоном.' },
  { icon: 'scale', title: 'Супровід до ключів', text: 'Юрист і нотаріус, дизайнери й ремонтні компанії, а ще бонуси — сертифікати на охорону, інтернет тощо.' },
];

const faq = [
  {
    q: 'Ви справді працюєте без комісії?',
    a: 'Так, для покупців — без комісії та відсотків. Ми співпрацюємо напряму з власниками та забудовниками, тож ви платите реальну ринкову вартість об’єкта.',
  },
  {
    q: 'Чи можна купити через єОселю або з сертифікатом єВідновлення?',
    a: 'Так. Підберемо об’єкти, які проходять за умовами програми, і супроводимо угоду разом з юристом і нотаріусом. Позначте програму в анкеті — менеджер одразу врахує це у підборі.',
  },
  {
    q: 'Я в іншому місті або за кордоном. Можна подивитися об’єкт дистанційно?',
    a: 'Так. Проводимо онлайн-перегляди по відеозв’язку та знімаємо детальні відеоогляди — частину з них можна подивитися в нашому Instagram.',
  },
  {
    q: 'Допоможете продати мою нерухомість?',
    a: 'Так. Підготуємо об’єкт до продажу, знімемо відеоогляд, покажемо його нашій аудиторії й приведемо покупців. Умови залежать від об’єкта — розповімо після короткої консультації. Оберіть у анкеті «Продати».',
  },
  {
    q: 'Де ваш офіс?',
    a: 'Ірпінь, вул. Мечникова, 32. Перед візитом краще зателефонувати: 097 097 77 74.',
  },
];
---

<Layout faq={faq}>
  <!-- ═══════════════ NAV ═══════════════ -->
  <header id="nav" class="fixed top-0 inset-x-0 z-50 transition-[background,border-color,backdrop-filter] duration-500 border-b border-transparent">
    <div class="container mx-auto px-5 md:px-6 flex items-center justify-between h-[72px] md:h-24">
      <a href="#top" aria-label="Modern Estate Agency — на початок" class="shrink-0">
        <Logo class="h-11 md:h-[58px] w-auto" id="nav-logo" />
      </a>
      <nav class="hidden lg:flex items-center gap-9 text-[13px] uppercase tracking-[0.18em] text-white/65" aria-label="Розділи">
        <a href="#ohliady" class="hover:text-champagne transition-colors">Огляди</a>
        <a href="#about" class="hover:text-champagne transition-colors">Агенція</a>
        <a href="#the-yard" class="hover:text-champagne transition-colors">The Yard</a>
        <a href="#prodazh" class="hover:text-champagne transition-colors">Продаж</a>
        <a href="#kontakty" class="hover:text-champagne transition-colors">Контакти</a>
      </nav>
      <div class="flex items-center gap-2 md:gap-3">
        <a href={contacts.phoneHref} class="hidden md:inline text-sm text-white/85 hover:text-champagne transition-colors mr-2 tabular-nums">{contacts.phone}</a>
        <a href={contacts.phoneHref} aria-label="Зателефонувати" class="md:hidden w-11 h-11 rounded-full btn-ghost inline-flex items-center justify-center">
          <Icon name="phone" className="w-[18px] h-[18px]" />
        </a>
        <a href={contacts.telegram} target="_blank" rel="noopener" aria-label="Написати менеджеру в Telegram" class="w-11 h-11 rounded-full btn-ghost inline-flex items-center justify-center text-[#5ab8ee]">
          <Icon name="telegram" className="w-[18px] h-[18px]" />
        </a>
        <button data-quiz data-quiz-source="Кнопка в шапці" class="btn-gold h-11 px-5 md:px-6 rounded-full text-[13px] md:text-sm font-semibold">
          Підібрати<span class="hidden sm:inline">&nbsp;об’єкт</span>
        </button>
      </div>
    </div>
  </header>

  <main id="top">
    <!-- ═══════════════ HERO ═══════════════ -->
    <section id="hero-section" class="relative min-h-[100svh] flex items-end overflow-hidden">
      <video
        id="hero-video"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={`${baseUrl}assets/hero-poster.webp`}
        class="absolute inset-0 w-full h-full object-cover scale-[1.08] will-change-transform"
        aria-hidden="true"
      >
        <source src={`${baseUrl}assets/hero-1080.mp4`} type="video/mp4" media="(min-width: 768px)" />
        <source src={`${baseUrl}assets/hero-720.mp4`} type="video/mp4" />
      </video>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_60%_40%,transparent_0%,rgba(0,0,0,0.45)_65%,rgba(0,0,0,0.85)_100%)]"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#050505] via-black/55 to-black/30"></div>

      <div class="container mx-auto px-5 md:px-6 relative z-10 pt-28 md:pt-36 pb-10 md:pb-16 grid lg:grid-cols-12 gap-9 lg:gap-10 items-end">
        <div class="lg:col-span-7">
          <div class="hero-in inline-flex items-center gap-2.5 mb-6 md:mb-8 px-3.5 py-1.5 rounded-full bg-white/[0.06] border border-white/10 backdrop-blur-md" style="--d:0.05s">
            <span class="w-1.5 h-1.5 rounded-full bg-champagne animate-pulse"></span>
            <span class="text-white/80 text-[11px] md:text-xs font-semibold tracking-[0.22em] uppercase">Київ та Київська область</span>
          </div>

          <h1 class="font-display text-white mb-6 md:mb-8 drop-shadow-[0_4px_24px_rgba(0,0,0,0.6)]">
            <span class="hero-in block" style="--d:0.15s">Знайдемо</span>
            <span class="hero-in block italic font-normal text-shimmer pr-3 pb-2 -mb-2" style="--d:0.3s">ваш дім</span>
            <span class="hero-in block" style="--d:0.45s">без комісії.</span>
          </h1>

          <p class="hero-in max-w-xl text-white/80 text-[17px] md:text-xl font-light leading-relaxed pl-4 border-l border-champagne/50" style="--d:0.6s">
            Будинки, дуплекси, таунхауси, квартири та комерція. Пройдіть коротку анкету — менеджер підбере актуальні варіанти напряму від власників і забудовників.
          </p>

          <div class="hero-in hidden lg:flex items-center gap-6 mt-10 text-sm text-white/55" style="--d:0.75s">
            <a href={contacts.phoneHref} class="inline-flex items-center gap-2 hover:text-champagne transition-colors"><Icon name="phone" className="w-4 h-4" /> {contacts.phone}</a>
            <span class="w-px h-4 bg-white/15"></span>
            <a href={contacts.telegram} target="_blank" rel="noopener" class="inline-flex items-center gap-2 hover:text-champagne transition-colors"><Icon name="telegram" className="w-4 h-4" /> Написати в Telegram</a>
          </div>
        </div>

        <div class="lg:col-span-5 hero-in" style="--d:0.55s">
          <div class="relative rounded-[1.6rem] border border-white/12 bg-black/45 backdrop-blur-xl p-5 md:p-7 shadow-[0_30px_80px_-30px_rgba(0,0,0,0.9)]">
            <div class="absolute inset-x-8 -top-px h-px bg-gradient-to-r from-transparent via-champagne/70 to-transparent"></div>
            <div class="flex items-baseline justify-between mb-4 md:mb-5">
              <p class="font-display text-2xl md:text-[1.7rem] text-white">Що шукаєте?</p>
              <p class="text-[11px] uppercase tracking-[0.2em] text-white/40">анкета · 1 хв</p>
            </div>
            <div class="grid grid-cols-3 gap-2">
              {
                pickers.map((p) => (
                  <button
                    data-quiz
                    data-quiz-goal={p.goal}
                    data-quiz-type={p.type}
                    data-quiz-source={`Хіро: «${p.label}»`}
                    class={`group flex rounded-2xl border px-3 py-3 md:px-4 md:py-4 text-left transition-all duration-300 active:scale-[0.97] ${
                      p.wide ? 'col-span-3 flex-row items-center gap-3' : 'flex-col items-start justify-between gap-3 md:gap-5'
                    } ${
                      p.goal === 'Продати'
                        ? 'border-champagne/30 bg-champagne/[0.07] hover:bg-champagne/[0.14] hover:border-champagne/70'
                        : 'border-white/10 bg-white/[0.04] hover:bg-white/[0.09] hover:border-white/30'
                    }`}
                  >
                    <Icon name={p.icon} className={`w-6 h-6 transition-colors ${p.goal === 'Продати' ? 'text-champagne' : 'text-white/55 group-hover:text-champagne'}`} />
                    <span class="w-full flex items-center justify-between text-[13px] md:text-[15px] font-medium text-white/90 leading-tight">
                      {p.label}
                      <Icon
                        name="arrow"
                        className={`w-4 h-4 transition-all ${p.wide ? 'text-champagne opacity-80' : 'opacity-0 -translate-x-1 group-hover:opacity-60 group-hover:translate-x-0 hidden md:block'}`}
                      />
                    </span>
                  </button>
                ))
              }
            </div>
            <div class="mt-4 md:mt-5 pt-4 border-t border-white/10 flex items-center justify-between gap-3 text-[12px] text-white/50">
              <span class="inline-flex items-center gap-1.5"><Icon name="check" className="w-4 h-4 text-champagne" /> 0% комісії</span>
              <span class="inline-flex items-center gap-1.5"><Icon name="check" className="w-4 h-4 text-champagne" /> єОселя</span>
              <span class="inline-flex items-center gap-1.5"><Icon name="check" className="w-4 h-4 text-champagne" /> Розтермінування</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════ TICKER ═══════════════ -->
    <div class="relative z-10 border-y border-white/[0.07] bg-[#070707] py-5 overflow-hidden" aria-hidden="true">
      <div class="ticker flex w-max gap-12 whitespace-nowrap">
        {
          [...ticker, ...ticker].map((t) => (
            <span class="inline-flex items-center gap-12 text-[13px] uppercase tracking-[0.24em] text-white/45">
              {t}
              <span class="text-champagne/60">✦</span>
            </span>
          ))
        }
      </div>
    </div>

    <!-- ═══════════════ QUIZ ═══════════════ -->
    <section id="pidbir" class="relative z-10 py-24 md:py-36 overflow-hidden scroll-mt-24">
      <div class="absolute inset-0 opacity-[0.18] mix-blend-overlay pointer-events-none" style={`background-image:url('${baseUrl}assets/marble.webp');background-size:cover;background-position:center`}></div>
      <div class="absolute -top-40 right-0 w-[700px] h-[700px] rounded-full bg-champagne blur-[180px] opacity-[0.06] pointer-events-none"></div>

      <div class="container mx-auto px-5 md:px-6 relative grid lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        <div class="lg:col-span-5 lg:sticky lg:top-32 reveal">
          <span class="eyebrow mb-6">Анкета підбору</span>
          <h2 class="font-display text-white mt-5 mb-7">
            Розкажіть, що шукаєте.<br />
            <span class="italic font-normal text-champagne">Решту зробимо ми.</span>
          </h2>
          <p class="text-white/60 text-lg font-light leading-relaxed lg:mb-10 max-w-md">
            Не треба гортати сотні оголошень. Кілька коротких питань — і менеджер одразу бачить ваш запит та підбирає варіанти з бази агенції й від забудовників.
          </p>

          <ol class="hidden lg:block space-y-6 mb-10">
            {
              [
                ['01', 'Анкета', 'Тип, локація, бюджет і спосіб оплати — займе хвилину.'],
                ['02', 'Підбір', 'Збираємо актуальні варіанти, зокрема ті, яких немає у відкритому доступі.'],
                ['03', 'Перегляд', 'Наживо або по відео. Далі — юрист, нотаріус і ключі.'],
              ].map(([n, t, d]) => (
                <li class="flex gap-5">
                  <span class="font-display text-champagne/80 text-xl w-8 shrink-0 pt-0.5">{n}</span>
                  <div>
                    <p class="text-white text-lg font-medium">{t}</p>
                    <p class="text-white/50 font-light leading-relaxed">{d}</p>
                  </div>
                </li>
              ))
            }
          </ol>

          <div class="hidden lg:flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-white/50">
            <span>Зручніше голосом?</span>
            <a href={contacts.phoneHref} class="text-white hover:text-champagne transition-colors tabular-nums">{contacts.phone}</a>
            <a href={contacts.telegram} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-white hover:text-champagne transition-colors">
              <Icon name="telegram" className="w-4 h-4 text-[#5ab8ee]" /> Telegram
            </a>
          </div>
        </div>

        <div id="anketa" class="lg:col-span-7 reveal scroll-mt-24 md:scroll-mt-28" style="transition-delay:0.1s">
          <LeadQuiz client:load />
        </div>
      </div>
    </section>

    <!-- ═══════════════ REVIEWS ═══════════════ -->
    <section id="ohliady" class="relative z-10 py-24 md:py-36 border-t border-white/[0.06] scroll-mt-20">
      <div class="container mx-auto px-5 md:px-6">
        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-8 mb-12 md:mb-14 reveal">
          <div class="max-w-2xl">
            <span class="eyebrow">Відеоогляди</span>
            <h2 class="font-display text-white mt-5">
              Каталог, який <span class="italic font-normal text-champagne">можна подивитися</span>
            </h2>
          </div>
          <div class="lg:max-w-sm">
            <p class="text-white/55 font-light leading-relaxed mb-5">
              Ми показуємо об’єкти так, як ви побачили б їх на перегляді: менеджер, реальні кімнати, чесні деталі. Сподобався формат — тисніть «Хочу схожий».
            </p>
            <a href="https://www.instagram.com/modern_estate_agency" target="_blank" rel="noopener" class="group inline-flex items-center gap-3">
              <span class="w-11 h-11 rounded-full p-[2px] bg-gradient-to-tr from-[#f09433] via-[#dc2743] to-[#bc1888]">
                <img src={`${baseUrl}assets/modern-estate-agency-logo.jpg`} alt="" width="40" height="40" loading="lazy" class="w-full h-full rounded-full border-2 border-black object-cover" />
              </span>
              <span class="leading-tight">
                <span class="block text-white text-sm font-semibold group-hover:text-champagne transition-colors">@modern_estate_agency</span>
                <span class="block text-white/45 text-xs">17,4 тис. підписників</span>
              </span>
            </a>
          </div>
        </div>
        <div class="reveal">
          <ReviewsTabs client:idle baseUrl={baseUrl} />
        </div>
      </div>
    </section>

    <!-- ═══════════════ ABOUT ═══════════════ -->
    <section id="about" class="relative z-10 py-24 md:py-36 border-t border-white/[0.06] overflow-hidden scroll-mt-20">
      <div class="absolute inset-0 opacity-[0.14] mix-blend-overlay pointer-events-none" style={`background-image:url('${baseUrl}assets/marble.webp');background-size:cover`}></div>
      <div class="container mx-auto px-5 md:px-6 relative">
        <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 mb-20 md:mb-28">
          <div class="lg:col-span-6 reveal">
            <span class="eyebrow">Про агенцію</span>
            <h2 class="font-display text-white mt-5 mb-8">
              Сучасна агенція нерухомості <span class="italic font-normal text-champagne">Києва та області</span>
            </h2>
            <div class="space-y-4 text-white/65 text-[17px] md:text-lg font-light leading-relaxed mb-9">
              <p>
                Modern Estate Agency — сучасна агенція нерухомості з офісом в Ірпені, що спеціалізується на продажу, купівлі та підборі житлової й комерційної нерухомості в Києві та Київській області.
              </p>
              <p>Ми об’єднуємо команду досвідчених фахівців, глибоке знання ринку та індивідуальний підхід до кожного клієнта.</p>
              <p>
                У нашому портфелі — приватні будинки, котеджі, дуплекси, таунхауси, квартири та комерційні об’єкти. Працюємо з широкою базою актуальних пропозицій, ексклюзивними об’єктами від власників і забудовників.
                <a href="#the-yard" class="text-champagne underline decoration-champagne/40 underline-offset-4 hover:decoration-champagne transition-colors">Також будуємо самостійно!</a>
              </p>
              <p>
                Ми допомагаємо знайти оптимальне рішення, перевіряємо об’єкти, організовуємо онлайн- та офлайн-перегляди й забезпечуємо професійний супровід на кожному етапі угоди.
              </p>
              <p class="font-display italic text-champagne text-xl md:text-2xl leading-snug pt-2">Modern Estate Agency — ваш надійний партнер у світі нерухомості.</p>
            </div>
            <a href={contacts.maps} target="_blank" rel="noopener" class="group inline-flex items-start gap-4 p-5 rounded-2xl border border-white/10 bg-white/[0.03] hover:border-champagne/40 transition-colors max-w-md">
              <span class="w-11 h-11 shrink-0 rounded-full border border-champagne/40 flex items-center justify-center text-champagne"><Icon name="pin" className="w-5 h-5" /></span>
              <span>
                <span class="block text-white font-medium mb-0.5 group-hover:text-champagne transition-colors">Наш офіс — Ірпінь, вул. Мечникова, 32</span>
                <span class="inline-flex items-center gap-1.5 text-white/50 text-sm font-light group-hover:text-champagne/80 transition-colors">Відкрити на карті <Icon name="external" className="w-3.5 h-3.5" /></span>
              </span>
            </a>
          </div>

          <div class="lg:col-span-6 grid grid-cols-2 gap-px bg-white/10 rounded-3xl overflow-hidden self-end reveal" style="transition-delay:0.1s">
            {
              [
                ['0%', 'комісії для покупця'],
                ['17,4k', 'підписників в Instagram'],
                ['14 років', 'досвіду роботи з забудовниками'],
                ['Platinum', 'партнер Rieltor.ua'],
              ].map(([n, l]) => (
                <div class="bg-[#080808] p-6 md:p-9 min-h-[150px] md:min-h-[190px] flex flex-col justify-between">
                  <span class="font-display text-[1.9rem] sm:text-[2.4rem] md:text-6xl leading-none text-white">{n}</span>
                  <span class="text-white/50 text-sm md:text-base font-light mt-4">{l}</span>
                </div>
              ))
            }
          </div>
        </div>

        <div class="reveal">
