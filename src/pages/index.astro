<script>
  import { openQuiz, scrollToId } from '../lib/quiz';

  // будь-яка кнопка з data-quiz відкриває анкету з передзаповненими відповідями;
  // якорі (#ohliady тощо) — плавно, з відступом під шапку
  document.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="#"]');
    if (link) {
      const id = link.getAttribute('href')!.slice(1);
      if (id === 'top') {
        e.preventDefault();
        (window as any).__lenis ? (window as any).__lenis.scrollTo(0) : window.scrollTo({ top: 0, behavior: 'smooth' });
      } else if (document.getElementById(id)) {
        e.preventDefault();
        scrollToId(id);
      }
      return;
    }
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-quiz]');
    if (!btn) return;
    e.preventDefault();
    const d = btn.dataset;
    openQuiz({
      goal: d.quizGoal,
      type: d.quizType,
      location: d.quizLocation ? d.quizLocation.split(',') : undefined,
      note: d.quizNote,
      source: d.quizSource,
    });
  });

  // шапка темнішає після першого екрану
  const nav = document.getElementById('nav')!;
  const onScroll = () => {
    const s = window.scrollY > 40;
    nav.classList.toggle('bg-black/75', s);
    nav.classList.toggle('backdrop-blur-xl', s);
    nav.classList.toggle('border-white/[0.08]', s);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // поява блоків
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((en) => {
        if (en.isIntersecting) {
          en.target.classList.add('is-visible');
          io.unobserve(en.target);
        }
      }),
    { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
  );
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

  // відео в хіро: легкий паралакс і пауза, коли його не видно
  const video = document.getElementById('hero-video') as HTMLVideoElement | null;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (video) {
    if (reduce) video.pause();
    let ticking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (ticking || reduce) return;
        ticking = true;
        requestAnimationFrame(() => {
          const y = window.scrollY;
          if (y < window.innerHeight * 1.2) video.style.transform = `translate3d(0, ${y * 0.35}px, 0) scale(1.08)`;
          ticking = false;
        });
      },
      { passive: true },
    );
    new IntersectionObserver(([en]) => {
      if (reduce) return;
      en.isIntersecting ? video.play().catch(() => {}) : video.pause();
    }).observe(video);
  }

  // рендер THE YARD повільно «наїжджає» при скролі
  const yard = document.querySelector<HTMLElement>('.yard-img');
  if (yard && !reduce) {
    window.addEventListener(
      'scroll',
      () => {
        const r = yard.getBoundingClientRect();
        const p = Math.min(Math.max(1 - r.top / window.innerHeight, 0), 1.6);
        yard.style.transform = `scale(${1.1 - p * 0.04})`;
      },
      { passive: true },
    );
  }
</script>

<style>
  .hero-in {
    opacity: 0;
    transform: translateY(26px);
    animation: hero-in 1.1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: var(--d, 0s);
  }
  @keyframes hero-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  .ticker {
    animation: ticker 48s linear infinite;
  }
  @keyframes ticker {
    to {
      transform: translateX(-50%);
    }
  }

  .faq[open] .faq-icon {
    transform: rotate(45deg);
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }

  .fan {
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-in {
      opacity: 1;
      transform: none;
      animation: none;
    }
    .ticker {
      animation: none;
    }
  }
</style>
