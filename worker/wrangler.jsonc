{
  // Приймає заявки з анкети сайту і шле їх у приватний Telegram-канал.
  // Деплой: cd worker && npx wrangler deploy
  // Секрети (один раз): npx wrangler secret put TG_BOT_TOKEN / TG_CHAT_ID
  "name": "modern-estate-leads",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Роут modern-estate-agency.com.ua/api/* не ставимо: у API-токена нема права Workers Routes на зону.
  // Фронт ходить на workers.dev (див. PUBLIC_LEAD_ENDPOINT у .env / src/data/site.ts).
  "vars": {
    "ALLOWED_ORIGINS": "https://modern-estate-agency.com.ua,https://www.modern-estate-agency.com.ua,http://localhost:4321,http://127.0.0.1:4321",
    "ALLOWED_ORIGIN_SUFFIX": ".modern-estate-agency.pages.dev"
  },
  "observability": { "enabled": true }
}
